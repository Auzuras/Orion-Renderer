#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rgba8, set = 0, binding = 0) uniform image2D image;

void main()
{
	ivec2 textCoord = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(image);

	if (textCoord.x >= size.x || textCoord.y >= size.y)
		return;

	imageStore(image, textCoord, vec4(SampleColor(lambda0, lambda1, lambda2), 1.0));
}